<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- РЎРµС‚СЊ Рё СЃРІСЏР·СЊ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Телефония и SMS (для блокировки звонков и спам-сообщений на планшетах с SIM) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- РџРёС‚Р°РЅРёРµ Рё С„РѕРЅРѕРІР°СЏ СЂР°Р±РѕС‚Р° -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Аппаратные модули и установка обновлений -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Видимость всех приложений и лаунчеров в системе для Kiosk / Device Owner (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <!-- Поиск всех лаунчеров и рабочих столов (Home) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Поиск всех запускаемых приложений -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".KioskApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KioskBrowser"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Р“Р»Р°РІРЅРѕРµ Activity: Р›Р°СѓРЅС‡РµСЂ Рё РљРёРѕСЃРє -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">

            <!-- Обычный запуск приложения -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Системный лаунчер (Главный экран по умолчанию) -->
            <intent-filter priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- NFC Intent Filter -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Device Admin Receiver РґР»СЏ Device Owner Рё РїРѕР»РёС‚РёРє Р±Р»РѕРєРёСЂРѕРІРєРё -->
        <receiver
            android:name=".admin.KioskDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- РђРІР°СЂРёР№РЅС‹Р№ ADB BroadcastReceiver РґР»СЏ РІС‹С…РѕРґР° РёР· РєРёРѕСЃРєР° СЂР°Р·СЂР°Р±РѕС‚С‡РёРєРѕРј -->
        <receiver
            android:name=".core.security.EmergencyBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kiosk.RESET_LOCK" />
                <action android:name="com.kiosk.RELOAD_PAGE" />
                <action android:name="com.kiosk.SET_URL" />
            </intent-filter>
        </receiver>

        <!-- Р РµСЃРёРІРµСЂ Р°РІС‚РѕР·Р°РїСѓСЃРєР° РїСЂРё РІРєР»СЋС‡РµРЅРёРё СѓСЃС‚СЂРѕР№СЃС‚РІР° -->
        <receiver
            android:name=".core.power.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Р¤РѕРЅРѕРІС‹Р№ СЃРµСЂРІРёСЃ РґР»СЏ MQTT-РєР»РёРµРЅС‚Р° Рё Р»РѕРєР°Р»СЊРЅРѕРіРѕ HTTP REST API -->
        <service
            android:name=".service.KioskForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="kiosk_iot_bridge" />
        </service>

        <!-- FileProvider для установки APK обновлений -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Receiver завершения установки обновлений -->
        <receiver
            android:name=".core.update.KioskUpdateReceiver"
            android:exported="false" />

        <!-- Блокировщик входящих вызовов для SIM -->
        <receiver
            android:name=".core.telephony.CallBlockReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter priority="999">
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Блокировщик входящих SMS сообщений для SIM -->
        <receiver
            android:name=".core.telephony.SmsBlockReceiver"
            android:enabled="true"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
